 drivers/nvme/host/speed_switch.c       | 418 +++++++++++++++++++++++++
 drivers/nvme/host/sysfs.c              | 143 +++++++++
 drivers/pci/controller/dwc/pcie-qcom.c |  21 ++
 8 files changed, 651 insertions(+)
